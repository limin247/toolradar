{
 "scenarios": [
  {
   "id": "terminal",
   "name": "终端与效率",
   "en": "Terminal",
   "blurb": "先问三个问题：你每天重复敲的命令有多少？有没有一款工具能把它变成一次模糊匹配？它是否尊重你的 .gitignore 和管道？",
   "accent": "#ffb454"
  },
  {
   "id": "ai-coding",
   "name": "AI 编程",
   "en": "AI Coding",
   "blurb": "先分清你要的是补全、是能自己跑命令的代理、还是只给代理加记忆/省钱的外挂——三者的选型完全不同。",
   "accent": "#7dd3fc"
  },
  {
   "id": "devtools",
   "name": "开发工具箱",
   "en": "Dev Tools",
   "blurb": "调接口、造假数据、查脚本、抓页面：这类工具的标准是「装完三分钟内能用上」，别选需要先写配置文件的。",
   "accent": "#a5b4fc"
  },
  {
   "id": "frontend",
   "name": "前端与设计",
   "en": "Frontend & Design",
   "blurb": "先分清你要「框架」还是「素材」：框架看生态和迁移成本，素材看授权与体积，别把两者混在一个决策里。",
   "accent": "#f9a8d4"
  },
  {
   "id": "devops",
   "name": "部署与运维",
   "en": "DevOps",
   "blurb": "先问：你是要少写 YAML，还是要少背锅？前者选 PaaS，后者选可观测性与密钥管理。",
   "accent": "#86efac"
  },
  {
   "id": "dataai",
   "name": "AI 与数据",
   "en": "AI & Data",
   "blurb": "先确认三件事：模型跑在哪、数据出不出内网、答案要不要可追溯。这三条决定你选本地推理还是托管 API。",
   "accent": "#67e8f9"
  },
  {
   "id": "database",
   "name": "数据存储",
   "en": "Database",
   "blurb": "先看你是「存业务数据」还是「查分析报表」：OLTP 和 OLAP 的选型几乎不重叠。",
   "accent": "#fcd34d"
  },
  {
   "id": "security",
   "name": "安全与隐私",
   "en": "Security",
   "blurb": "先分清进攻面和防守面：扫自己的代码用扫描器，理解流量用抓包代理，别拿渗透工具当日常检查。",
   "accent": "#fca5a5"
  },
  {
   "id": "testing",
   "name": "测试与质量",
   "en": "Testing",
   "blurb": "先问：你要测「行为」还是测「实现」？测行为选 E2E 和组件测试，测实现只会让你每次重构都改测试。",
   "accent": "#c4b5fd"
  },
  {
   "id": "docs",
   "name": "文档与知识",
   "en": "Docs & Knowledge",
   "blurb": "先问：这份内容给团队看还是给自己看？给团队就要版本化和评审，给自己只要快和离线。",
   "accent": "#fde68a"
  },
  {
   "id": "productivity",
   "name": "效率与个人",
   "en": "Productivity",
   "blurb": "这类工具的坑是「装完就忘了用」。只选能嵌进你现有流程的那一个，别同时开三个待办。",
   "accent": "#fdba74"
  },
  {
   "id": "selfhosted",
   "name": "自建与个人云",
   "en": "Self-hosted",
   "blurb": "先算清成本：自建省的是订阅费，花的是运维时间。优先选「一个 docker compose 就能起」的。",
   "accent": "#5eead4"
  },
  {
   "id": "learn",
   "name": "学习与面试",
   "en": "Learning",
   "blurb": "别收藏，直接做题。选型标准只有一条：它有没有让你动手的部分。纯清单类的价值在于索引，不在于读完。",
   "accent": "#93c5fd"
  },
  {
   "id": "collections",
   "name": "精选合集",
   "en": "Collections",
   "blurb": "合集是索引不是内容。挑一个就够，剩下的时间用来读里面的项目。",
   "accent": "#e5e7eb"
  }
 ],
